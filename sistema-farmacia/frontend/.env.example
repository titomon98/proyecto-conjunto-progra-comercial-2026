# Copiar este archivo como .env. El .env NO se sube al repositorio (ver .gitignore).
#
# URL base de la API del backend. Los modulos la leen con import.meta.env.VITE_API_URL.
# Vite solo expone al navegador las variables que empiezan con VITE_.
# Si el backend corre en el puerto por defecto, este valor ya sirve tal cual.
VITE_API_URL=http://localhost:3000/api
