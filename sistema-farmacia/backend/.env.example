# Copiar este archivo como .env y llenar los valores reales.
# El archivo .env NO se sube al repositorio (ver .gitignore).

PORT=3000

# Credenciales del proyecto de Supabase (PostgreSQL)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key

# Secreto para firmar los tokens de sesion
JWT_SECRET=cambiar-este-valor
